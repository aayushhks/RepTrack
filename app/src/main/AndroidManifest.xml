<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for Firebase sign-in now, and for the exercise catalog later. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Run tracking. Location is asked for only when the user taps Start on a run, and only
         while the app is in use: there is no background location permission. The foreground
         service keeps tracking with the screen off and shows a notification the whole time. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app see whether Instagram is installed, to offer "Instagram story". Since
         Android 11, apps only see the other apps they name here. -->
    <queries>
        <package android:name="com.instagram.android" />
    </queries>

    <!-- allowBackup is off so workout data and run routes are not copied to cloud backups.
         enableOnBackInvokedCallback turns on predictive back (the swipe-back preview) on Android 13 to 15.
         Android 16 and newer have it on already. -->
    <application
        android:name=".RepTrackApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RepTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RepTrack">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Hands story pictures to Instagram and other apps as content:// links. Only the
             folder in res/xml/share_paths.xml is shared, and only when the user shares. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
